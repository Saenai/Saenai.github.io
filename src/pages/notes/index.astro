---
import { getNotes } from '../../data/content';
import { messages, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteRow from '../../components/NoteRow.astro';
interface Props { locale?: Locale }
const { locale = 'zh-CN' } = Astro.props;
const t = messages[locale].notes;
const notes = await getNotes(locale);
---
<BaseLayout locale={locale} title={t.title} description={t.description}>
  <header class="page-heading"><p class="eyebrow">FIELD NOTES / {t.eyebrow}</p><h1>{t.heading}<span>.</span></h1><p>{t.intro}</p></header>
  <div class="archive-label"><span class="eyebrow">ALL ENTRIES</span><span>{t.count.replace('{count}', String(notes.length))}</span></div>
  <div class="notes-list">{notes.map(note => <NoteRow note={note} />)}</div>
  {notes.length === 0 && <p class="empty-state">{t.empty}</p>}
  <p class="archive-footnote">{t.footnote}</p>
</BaseLayout>
