---
import { getProjects, getNotes } from '../data/content';
import { localizedPath, messages, type Locale } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityArt from '../components/IdentityArt.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import { site } from '../data/site';

interface Props { locale?: Locale }
const { locale = 'zh-CN' } = Astro.props;
const t = messages[locale].home;
const projects = (await getProjects(locale)).filter(project => project.data.featured);
const notes = (await getNotes(locale)).slice(0, 3);
---
<BaseLayout locale={locale}>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> A SMALL CORNER OF THE INTERNET</p>
      <h1 id="intro-title"><span class="hero-greeting">{t.greeting}</span><span class="hero-name">Saenai<span>.</span></span></h1>
      <p class="hero-tagline">{t.tagline}</p>
      <p class="hero-description">{t.welcome}<br />{t.description}</p>
      <div class="hero-actions"><a class="button button-primary" href={localizedPath(locale, '/about/')}>{t.about} <span aria-hidden="true">↗</span></a><a class="text-link" href={site.github}>{t.github} <span aria-hidden="true">↗</span></a></div>
    </div>
    <IdentityArt />
  </section>
  <div class="intro-strip"><span class="eyebrow">THINGS YOU'LL FIND HERE</span><p>{t.threads.map((thread, index) => <span>0{index + 1} <b>{thread}</b></span>)}</p><a href="#selected">{t.explore} <span aria-hidden="true">↓</span></a></div>
  <section id="selected" class="home-section" aria-labelledby="projects-title">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="projects-title">{t.projects}<span>.</span></h2></div><a class="text-link" href={localizedPath(locale, '/projects/')}>{t.allProjects} <span aria-hidden="true">↗</span></a></div>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
  </section>
  <section class="home-section notes-section" aria-labelledby="notes-title">
    <div class="section-heading"><div><p class="eyebrow">02 / FIELD NOTES</p><h2 id="notes-title">{t.notes}<span>.</span></h2></div><a class="text-link" href={localizedPath(locale, '/notes/')}>{t.allNotes} <span aria-hidden="true">↗</span></a></div>
    <div class="notes-list">{notes.map(note => <NoteRow note={note} />)}</div>
  </section>
  <section class="hello-section" aria-labelledby="hello-title"><span class="hello-asterisk" aria-hidden="true">✳</span><div><p class="eyebrow">LET'S CONNECT</p><h2 id="hello-title">{t.hello}</h2><p>{t.connect}</p></div><a class="button button-outline" href={site.github}>{t.visit} <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
