---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityArt from '../components/IdentityArt.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteRow from '../components/NoteRow.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> A SMALL CORNER OF THE INTERNET</p>
      <h1 id="intro-title"><span class="hero-greeting">你好，我是</span><span class="hero-name">Saenai<span>.</span></span></h1>
      <p class="hero-tagline">把想法，慢慢做出来。</p>
      <p class="hero-description">欢迎来到我的个人空间。<br />这里收集代码、项目，以及探索过程中的笔记。</p>
      <div class="hero-actions"><a class="button button-primary" href="/about/">认识一下 <span aria-hidden="true">↗</span></a><a class="text-link" href={site.github}>在 GitHub 找到我 <span aria-hidden="true">↗</span></a></div>
    </div>
    <IdentityArt />
  </section>
  <div class="intro-strip"><span class="eyebrow">THINGS YOU'LL FIND HERE</span><p><span>01 <b>代码与工具</b></span><span>02 <b>学习与记录</b></span><span>03 <b>想法与实验</b></span></p><a href="#selected">向下探索 <span aria-hidden="true">↓</span></a></div>
  <section id="selected" class="home-section" aria-labelledby="projects-title">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="projects-title">一些正在成形的想法<span>.</span></h2></div><a class="text-link" href="/projects/">全部项目 <span aria-hidden="true">↗</span></a></div>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
  </section>
  <section class="home-section notes-section" aria-labelledby="notes-title">
    <div class="section-heading"><div><p class="eyebrow">02 / FIELD NOTES</p><h2 id="notes-title">在实践中，留下记录<span>.</span></h2></div><a class="text-link" href="/notes/">全部笔记 <span aria-hidden="true">↗</span></a></div>
    <div class="notes-list">{notes.map(note => <NoteRow note={note} />)}</div>
  </section>
  <section class="hello-section" aria-labelledby="hello-title"><span class="hello-asterisk" aria-hidden="true">✳</span><div><p class="eyebrow">LET'S CONNECT</p><h2 id="hello-title">很高兴，在这里遇见你。</h2><p>从一个项目、一个问题，或一个新想法开始。</p></div><a class="button button-outline" href={site.github}>去 GitHub 看看 <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
