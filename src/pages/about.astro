---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdentityArt from '../components/IdentityArt.astro';
import { site } from '../data/site';
import { localizedPath, messages, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'zh-CN' } = Astro.props;
const t = messages[locale].about;
const directions = [
  { id: 'prompt-batch-tool', eyebrow: '01 / AI TOOLS' },
  { id: 'microsoft-todo-safe-mcp', eyebrow: '02 / WORKFLOWS' },
  { id: 'japanese-analyzer', eyebrow: '03 / LEARNING' },
];
---
<BaseLayout locale={locale} title={t.title} description={t.description}>
  <header class="page-heading"><p class="eyebrow">BEHIND THE SCREEN / {t.title}</p><h1>{t.heading}<span>.</span></h1><p>{t.intro}</p></header>
  <section class="about-intro"><IdentityArt /><div class="prose"><h2>{t.space}</h2>{t.paragraphs.map(paragraph => <p>{paragraph}</p>)}<a class="button button-primary" href={site.github}>{messages[locale].home.github} <span aria-hidden="true">↗</span></a></div></section>
  <section class="about-directions"><div class="section-heading"><div><p class="eyebrow">A FEW THREADS TO FOLLOW</p><h2>{t.threads}<span>.</span></h2></div></div><div class="direction-grid">{directions.map((direction, index) => <a href={localizedPath(locale, `/projects/${direction.id}/`)}><span class="eyebrow">{direction.eyebrow}</span><h3>{t.directions[index].title} ↗</h3><p>{t.directions[index].description}</p></a>)}</div></section>
</BaseLayout>
