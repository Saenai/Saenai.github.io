---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import { localizedPath, messages } from '../../i18n';
export async function getStaticPaths() {
  return (await getCollection('projects', ({ data }) => data.locale === 'zh-CN')).map(project => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const locale = project.data.locale;
const t = messages[locale].projects;
const { Content } = await render(project);
---
<BaseLayout locale={locale} title={project.data.title} description={project.data.description}>
  <header class="page-heading detail-heading"><a class="back-link" href={localizedPath(locale, '/projects/')}>{t.back}</a><p class="eyebrow">PROJECT / {project.data.category}</p><h1>{project.data.title}<span>.</span></h1><p>{project.data.description}</p><div class="detail-tags">{project.data.tags.map(tag => <span>{tag}</span>)}</div></header>
  <div class="project-detail"><aside><ProjectArt variant={project.data.visual} /><a class="button button-primary" href={project.data.repository}>{t.repository} <span aria-hidden="true">↗</span></a><p class="small-note">{t.disclaimer}</p></aside><article class="prose"><Content /></article></div>
</BaseLayout>
