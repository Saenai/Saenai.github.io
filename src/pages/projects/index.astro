---
import { getProjects } from '../../data/content';
import { messages, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
interface Props { locale?: Locale }
const { locale = 'zh-CN' } = Astro.props;
const t = messages[locale].projects;
const projects = await getProjects(locale);
const categories = [...new Set(projects.map(project => project.data.category))];
---
<BaseLayout locale={locale} title={t.title} description={t.description}>
  <header class="page-heading"><p class="eyebrow">THE WORKBENCH / {t.eyebrow}</p><h1>{t.heading}<span>.</span></h1><p>{t.intro}</p></header>
  <div class="project-toolbar"><div class="project-filters" role="group" aria-label={t.filter} hidden><button type="button" data-filter="all" aria-pressed="true">{t.all}</button>{categories.map(category => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}</div><p class="result-count" role="status" aria-live="polite" data-template={t.count}>{t.count.replace('{count}', String(projects.length))}</p></div>
  <div class="project-grid project-grid--archive">{projects.map(project => <ProjectCard project={project} />)}</div>
  <p class="archive-footnote">{t.more} <a href="https://github.com/Saenai?tab=repositories">{t.repositories} ↗</a></p>
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>('.project-filters')!;
  const buttons = filters.querySelectorAll<HTMLButtonElement>('button');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const count = document.querySelector<HTMLElement>('.result-count')!;
  filters.hidden = false;
  buttons.forEach(button => button.addEventListener('click', () => {
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    let visible = 0;
    cards.forEach(card => {
      card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter;
      if (!card.hidden) visible++;
    });
    count.textContent = count.dataset.template!.replace('{count}', String(visible));
  }));
</script>
