---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath, messages, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'zh-CN' } = Astro.props;
const t = messages[locale].notFound;
---
<BaseLayout locale={locale} title={t.title} noindex><section class="not-found"><p class="eyebrow">A SMALL DETOUR</p><span class="error-number">404<span>.</span></span><h1>{t.heading}</h1><p>{t.description}</p><a class="button button-primary" href={localizedPath(locale, '/')}>{t.home} <span aria-hidden="true">↗</span></a></section></BaseLayout>
