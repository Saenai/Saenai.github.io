---
import { site } from '../data/site';
import { languages, locales, localizedPath, messages, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
  locale?: Locale;
}
const { title, locale = 'zh-CN', description = messages[locale].description, article = false, noindex = false } = Astro.props;
const t = messages[locale];
const pageTitle = title ? `${title} · ${site.name}` : t.title;
const pathname = Astro.url.pathname;
const pagePath = pathname.slice(locales[locale].prefix.length) || '/';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(pathname, Astro.site)} />
    {!noindex && <>
      {languages.map(language => <link rel="alternate" hreflang={language} href={new URL(localizedPath(language, pagePath), Astro.site)} />)}
      <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('zh-CN', pagePath), Astro.site)} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={locales[locale].og} />
    {languages.filter(language => language !== locale).map(language => <meta property="og:locale:alternate" content={locales[language].og} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header wrap">
      <a class="brand" href={localizedPath(locale, '/')} aria-label={t.homeLabel}><span class="brand-symbol" aria-hidden="true">s.</span>saenai<span class="brand-dot">.</span></a>
      <nav class="site-nav" aria-label={t.mainNav}>
        {site.navigation.map((href, index) => (
          <a href={localizedPath(locale, href)} aria-current={(href === '/' ? pagePath === href : pagePath.startsWith(href)) ? 'page' : undefined}>{t.nav[index]}</a>
        ))}
      </nav>
      <div class="header-actions">
        <nav class="language-switcher" aria-label={t.languageNav}>
          {languages.map(language => <a href={localizedPath(language, pagePath)} lang={language} hreflang={language} aria-current={language === locale ? 'true' : undefined}>{locales[language].label}</a>)}
        </nav>
        <a class="header-github" href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main" class="wrap" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <a class="footer-name" href={localizedPath(locale, '/')}>Saenai<span>.</span></a>
      <p>{t.footer}</p>
      <div><a href={site.github}>GitHub ↗</a><a href={site.repository}>{t.source} ↗</a><span>© {new Date().getFullYear()} Saenai</span></div>
    </footer>
  </body>
</html>
